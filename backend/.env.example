# Copy to backend/.env and adjust. All have dev-safe defaults in app/core/config.py.
ENVIRONMENT=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://studysync:studysync@localhost:5432/studysync
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-insecure-change-me
ACCESS_TOKEN_TTL_MINUTES=1440

LOG_LEVEL=INFO
LOG_JSON=false
